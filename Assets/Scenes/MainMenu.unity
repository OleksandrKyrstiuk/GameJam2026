  m_text: "\u0417\u0431\u0435\u0440\u0438\u0441\u044F \u043D\u0430 \u0440\u043E\u0431\u043E\u0442\u0443
    \u044F\u043A\u043E\u043C\u043E\u0433\u0430 \u0448\u0432\u0438\u0434\u0448\u0435.\n\u0412\u0438\u043A\u043E\u043D\u0443\u0439
    \u0437\u0430\u0432\u0434\u0430\u043D\u043D\u044F \u0442\u0430 \u0448\u0443\u043A\u0430\u0439
    \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u0456 \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u0438.\n\u0410\u043B\u0435
    \u043F\u0430\u043C'\u044F\u0442\u0430\u0439: \u0443 \u0446\u044C\u043E\u043C\u0443
    \u0431\u0443\u0434\u0438\u043D\u043A\u0443 \u043D\u0456\u0447\u043E\u0433\u043E
    \u043D\u0435 \u043F\u0440\u0430\u0446\u044E\u0454 \u0442\u0430\u043A, \u044F\u043A
    \u043F\u043E\u0432\u0438\u043D\u043D\u043E.\n\nWASD \u2014 \u0440\u0443\u0445
